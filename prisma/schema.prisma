generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  TENANT
  OWNER
  BROKER
  BUILDER
  ADMIN
}

enum PropertyType {
  BUY
  RENT
  PG
  PLOT
  COMMERCIAL
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id             String   @id @default(cuid())
  selfiamId      String   @unique
  name           String
  email          String   @unique
  phone          String?
  role           Role     @default(BUYER)
  experience     Int?
  specialization String?
  areasCovered   String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  properties  Property[]
  leads       Lead[]
  savedProps  SavedProperty[]
  siteVisits  SiteVisit[]
  serviceRequests ServiceRequest[]

  roomServiceRequests RoomServiceRequest[]
  designRequests      DesignRequest[]
}


model Property {
  id           String         @id @default(cuid())
  title        String
  description  String
  type         PropertyType
  status       PropertyStatus @default(PENDING)
  price        Int
  bhk          Int?
  carpetArea   Int?
  city         String
  locality     String
  address      String?
  images       String[]       // Cloudinary URLs
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner        User           @relation(fields: [ownerId], references: [id])
  ownerId      String

  leads        Lead[]
  savedBy      SavedProperty[]
  siteVisits   SiteVisit[]
}

enum LeadStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  NEGOTIATION
  CLOSED
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  message     String?
  status      LeadStatus @default(NEW)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  property    Property   @relation(fields: [propertyId], references: [id])
  propertyId  String

  user        User       @relation(fields: [userId], references: [id])
  userId      String
}

model SavedProperty {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id])
  propertyId  String

  user        User     @relation(fields: [userId], references: [id])
  userId      String

  @@unique([userId, propertyId])
}

model SiteVisit {
  id          String   @id @default(cuid())
  scheduledAt DateTime
  status      String   @default("REQUESTED")
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id])
  propertyId  String

  user        User     @relation(fields: [userId], references: [id])
  userId      String
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum ServiceType {
  PACKERS_MOVERS
  CLEANING
  PAINTING
  INTERIOR_DESIGN
  ELECTRICAL
  PLUMBING
  PEST_CONTROL
  PROPERTY_INSPECTION
}

model ServiceRequest {
  id          String      @id @default(cuid())
  serviceType ServiceType
  city        String
  phone       String
  notes       String?
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])
  userId      String
}

enum ServiceCategory {
  CLEANING_HOUSEKEEPING
  ON_DEMAND_REPAIR
  CONCIERGE_LIFESTYLE
}

enum ServiceRequestStatus {
  RECEIVED
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model RoomServiceRequest {
  id              String                @id @default(cuid())
  category        ServiceCategory
  subService      String                // e.g. "Electrical", "Deep Cleaning"
  status          ServiceRequestStatus  @default(RECEIVED)
  scheduledDate   DateTime?
  address         String
  notes           String?

  // Technician fields — nullable for now, filled in once real vendor network exists
  technicianName  String?
  technicianPhone String?
  technicianPhoto String?
  technicianRating Float?

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt

  user            User                  @relation(fields: [userId], references: [id])
  userId          String
}

enum FurnishingLevel {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

model DesignRequest {
  id                String          @id @default(cuid())
  propertyId        String?
  furnishingLevel   FurnishingLevel
  addOns            String[]        // e.g. ["Modular Kitchen", "Smart Home"]
  interiorStyle     String?         // e.g. "Minimalist"
  baseCost          Int
  addOnCost         Int             @default(0)
  totalMonthlyCost  Int
  status            String          @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED

  createdAt         DateTime        @default(now())

  user              User            @relation(fields: [userId], references: [id])
  userId            String
}